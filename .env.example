# Midnight Satin - Environment variables
# Copy to .env.local and fill in values

# Vercel Postgres (required for data persistence)
POSTGRES_URL=

# Vercel Blob (for image assets)
BLOB_READ_WRITE_TOKEN=

# Vercel KV (for caching)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# MCP API key - required for /api/mcp content agent access (Req 12.9)
# Use Authorization: Bearer <key> or X-API-Key: <key>
MCP_API_KEY=

# Stripe (required for payments - credit packs and paperback purchases)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Paperback Purchase Feature
# Set to "true" to enable the active purchase flow; "false" shows Coming Soon state
NEXT_PUBLIC_PAPERBACK_ENABLED=false

# When the purchase page is visible, set to "true" to enable Stripe checkout on Buy now.
NEXT_PUBLIC_PAPERBACK_PURCHASE_ENABLED=false

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
