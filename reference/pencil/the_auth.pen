                    "align": "inside",
                    "thickness": 1,
                    "fill": "#D4AF3733"
                  },
                  "cornerRadius": 0,
                  "layout": "horizontal",
                  "alignItems": "center",
                  "padding": [
                    0,
                    16
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "artboard-signin-mobile-ph-email",
                      "content": "you@example.com",
                      "fill": "$color.textMuted",
                      "fontFamily": "Literata",
                      "fontSize": 14,
                      "fontWeight": "normal",
                      "textGrowth": "auto"
                    }
