                      "fontSize": 12,
                      "fontWeight": "normal",
                      "letterSpacing": 1,
                      "textGrowth": "auto"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "nat-summary",
                  "content": "The next chapter of Midnight Satin brings new voices, deeper worlds, and more ways for readers to shape the stories they love.",
                  "fill": "$color.textMuted",
                  "fontFamily": "Literata",
                  "fontSize": 20,
                  "fontWeight": "normal",
                  "fontStyle": "italic",
                  "lineHeight": 1.55,
                  "textAlign": "center",
