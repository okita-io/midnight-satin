                  "textGrowth": "fixed-width"
                },
                {
                  "type": "frame",
                  "id": "nat-ornament",
                  "width": "fill_container",
                  "layout": "horizontal",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "gap": 12,
                  "children": [
                    {
                      "type": "rectangle",
                      "id": "nat-ornament-rule-l",
                      "width": 32,
                      "height": 1,
                      "fill": "$color.primary"
                    },
                    {
                      "type": "rectangle",
